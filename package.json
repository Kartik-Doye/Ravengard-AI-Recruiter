{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "sitemap": "node scripts/generate-sitemap.cjs",
    "build": "npm run sitemap && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 0",
    "qa": "node scripts/qa-check-routes.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@types/styled-components": "^5.1.36",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "googleapis": "^174.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.1",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
