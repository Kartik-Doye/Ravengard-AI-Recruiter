{
  "name": "ravengard-ai-recruiter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "sitemap": "node scripts/generate-sitemap.cjs",
    "validate-build": "tsx scripts/validate-build.ts",
    "build": "npm run clean && npm run sitemap && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs && npm run validate-build",
    "start": "node build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist build server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:public-apis": "tsx scripts/test_public_apis.ts",
    "test:admin:stress": "tsx scripts/stress_test_admin.ts",
    "qa": "node scripts/qa-check-routes.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate_assessment_expires_at.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.1",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "openai": "^7.18.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.28",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "unpdf": "^1.8.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/styled-components": "^5.1.36",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.1.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3"
  }
}
