# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: For Groq Cloud API
GROQ_API_KEY="MY_GROQ_API_KEY"

# OPENROUTER_API_KEY: For OpenRouter API
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# MISTRAL_API_KEY: For Mistral AI API
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"

# NVIDIA_API_KEY: For NVIDIA NIM API
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# CLOUDFLARE_API_KEY: For Cloudflare Workers AI API
CLOUDFLARE_API_KEY="MY_CLOUDFLARE_API_KEY"
# CLOUDFLARE_ACCOUNT_ID: Your Cloudflare account ID
CLOUDFLARE_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"

# GITHUB_TOKEN: For GitHub Models API (requires models:read scope)
GITHUB_TOKEN="MY_GITHUB_TOKEN"

# SILICONFLOW_API_KEY: For SiliconFlow API
SILICONFLOW_API_KEY="MY_SILICONFLOW_API_KEY"

# COHERE_API_KEY: For Cohere API
COHERE_API_KEY="MY_COHERE_API_KEY"

# QWEN_API_KEY: For Qwen Studio API
QWEN_API_KEY="MY_QWEN_API_KEY"

# HUGGINGFACE_API_KEY: For Hugging Face Inference API
HUGGINGFACE_API_KEY="MY_HUGGINGFACE_API_KEY"

# OLLAMA_BASE_URL: For Ollama (default http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret used for signing candidate and admin authentication tokens.
JWT_SECRET=